---
import { type Lang, useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categories = [
  {
    key: 'document',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
    color: 'accent',
    tools: [
      { href: `/${lang}/doc-to-markdown`, label: t('tools.docToMarkdown'), emoji: '📑' },
      { href: `/${lang}/html-to-markdown`, label: t('tools.htmlToMarkdown'), emoji: '🌐' },
      { href: `/${lang}/markdown-to-pdf`, label: t('tools.markdownToPdf'), emoji: '📄' },
    ]
  },
  {
    key: 'text',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>`,
    color: 'chatgpt',
    tools: [
      { href: `/${lang}/text-case`, label: t('tools.textCase'), emoji: 'Aa' },
      { href: `/${lang}/url-encoder`, label: t('tools.urlEncoder'), emoji: '🔗' },
      { href: `/${lang}/csv-to-json`, label: t('tools.csvToJson'), emoji: '📊' },
      { href: `/${lang}/markdown-table`, label: t('tools.markdownTable'), emoji: '📝' },
    ]
  },
  {
    key: 'code',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    color: 'claude',
    tools: [
      { href: `/${lang}/code-to-pdf`, label: t('tools.codeToPdf'), emoji: '💻' },
      { href: `/${lang}/diff-checker`, label: t('tools.diffChecker'), emoji: '⚖️' },
      { href: `/${lang}/json-to-markdown`, label: t('tools.jsonToMarkdown'), emoji: '📋' },
    ]
  },
  {
    key: 'chatExport',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
    color: 'gemini',
    tools: [
      { href: `/${lang}/chatgpt-export`, label: 'ChatGPT', emoji: '🟢' },
      { href: `/${lang}/claude-export`, label: 'Claude', emoji: '🟣' },
      { href: `/${lang}/gemini-export`, label: 'Gemini', emoji: '🔵' },
      { href: `/${lang}/deepseek-export`, label: 'DeepSeek', emoji: '🟡' },
    ]
  },
];
---

<section id="tools" class="py-20 bg-bg-secondary/50">
  <div class="container-custom">
    <h2 class="section-title">{t('toolCategories.title')}</h2>
    <p class="section-subtitle">{t('toolCategories.subtitle')}</p>

    <div class="grid md:grid-cols-2 gap-8 mt-12">
      {categories.map((category) => (
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-4">
            <div class={`w-10 h-10 rounded-lg bg-${category.color}/10 text-${category.color} flex items-center justify-center`}>
              <Fragment set:html={category.icon} />
            </div>
            <div>
              <h3 class="text-lg font-semibold text-white">
                {t(`toolCategories.${category.key}.title`)}
              </h3>
              <p class="text-sm text-gray-500">
                {t(`toolCategories.${category.key}.description`)}
              </p>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            {category.tools.map((tool) => (
              <a
                href={tool.href}
                class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-colors border border-white/5"
              >
                <span class="text-base">{tool.emoji}</span>
                <span>{tool.label}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
