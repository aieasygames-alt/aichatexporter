---
import Layout from '../../layouts/Layout.astro';
import { type Lang, useTranslations, languages } from '../../i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout
  title={t('download.title')}
  description={t('download.description')}
  keywords={t('download.keywords')}
  lang={lang}
>
  <section class="py-16 lg:py-24">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <!-- Hero -->
        <div class="text-center mb-16">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent/10 text-accent text-sm font-medium mb-6">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t('download.badge')}
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold mb-4">
            <span class="gradient-text">{t('download.h1')}</span>
          </h1>
          <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-8">
            {t('download.subtitle')}
          </p>

          <!-- Download Button -->
          <a
            href="/ai-chat-exporter.zip"
            download="ai-chat-exporter.zip"
            class="btn-primary text-lg px-10 py-4 inline-flex items-center gap-3"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t('download.button')}
          </a>
          <p class="text-sm text-gray-500 mt-4">
            {t('download.fileInfo')}
          </p>
        </div>

        <!-- Installation Steps -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-center mb-10">
            {t('download.stepsTitle')}
          </h2>
          <div class="space-y-6">
            <!-- Step 1 -->
            <div class="flex gap-4 items-start bg-bg-secondary rounded-xl p-6 border border-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold text-lg">
                1
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-2">{t('download.step1Title')}</h3>
                <p class="text-gray-400">{t('download.step1Desc')}</p>
              </div>
              <div class="flex-shrink-0">
                <a
                  href="/ai-chat-exporter.zip"
                  download="ai-chat-exporter.zip"
                  class="text-accent hover:text-accent/80 transition-colors"
                >
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Step 2 -->
            <div class="flex gap-4 items-start bg-bg-secondary rounded-xl p-6 border border-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold text-lg">
                2
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-2">{t('download.step2Title')}</h3>
                <p class="text-gray-400">{t('download.step2Desc')}</p>
              </div>
              <div class="flex-shrink-0 text-gray-500">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </div>
            </div>

            <!-- Step 3 -->
            <div class="flex gap-4 items-start bg-bg-secondary rounded-xl p-6 border border-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold text-lg">
                3
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-2">{t('download.step3Title')}</h3>
                <p class="text-gray-400">{t('download.step3Desc')}</p>
              </div>
              <div class="flex-shrink-0 text-gray-500">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
              </div>
            </div>

            <!-- Step 4 -->
            <div class="flex gap-4 items-start bg-bg-secondary rounded-xl p-6 border border-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold text-lg">
                4
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-2">{t('download.step4Title')}</h3>
                <p class="text-gray-400">{t('download.step4Desc')}</p>
              </div>
              <div class="flex-shrink-0 text-gray-500">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
            </div>

            <!-- Step 5 -->
            <div class="flex gap-4 items-start bg-bg-secondary rounded-xl p-6 border border-white/5">
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-accent/20 text-accent flex items-center justify-center font-bold text-lg">
                5
              </div>
              <div class="flex-1">
                <h3 class="font-semibold text-lg mb-2">{t('download.step5Title')}</h3>
                <p class="text-gray-400">{t('download.step5Desc')}</p>
              </div>
              <div class="flex-shrink-0 text-gray-500">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Visual Guide -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-center mb-10">
            {t('download.visualTitle')}
          </h2>

          <!-- Screenshot-style guide with dark theme mockups -->
          <div class="space-y-8">
            <!-- Step 2 Visual: Extensions page -->
            <div class="bg-bg-secondary rounded-xl border border-white/10 overflow-hidden">
              <div class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/5">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
                </div>
                <div class="flex-1 text-center text-xs text-gray-500">
                  chrome://extensions
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between mb-6">
                  <h3 class="font-semibold text-lg">{t('download.visualExtTitle')}</h3>
                  <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-500">{t('download.visualDeveloperMode')}</span>
                    <div class="w-10 h-6 bg-accent rounded-full relative">
                      <div class="absolute right-0.5 top-0.5 w-5 h-5 bg-white rounded-full"></div>
                    </div>
                  </div>
                </div>
                <div class="border-2 border-dashed border-accent/50 rounded-lg p-4 text-center">
                  <p class="text-accent text-sm font-medium">{t('download.visualToggle')}</p>
                </div>
              </div>
            </div>

            <!-- Step 4 Visual: Load unpacked -->
            <div class="bg-bg-secondary rounded-xl border border-white/10 overflow-hidden">
              <div class="flex items-center gap-2 px-4 py-3 bg-white/5 border-b border-white/5">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
                  <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
                </div>
              </div>
              <div class="p-6">
                <div class="flex items-center gap-4 mb-4">
                  <button class="px-4 py-2 bg-accent text-white rounded-lg text-sm font-medium">
                    {t('download.visualLoadUnpacked')}
                  </button>
                  <button class="px-4 py-2 bg-white/5 text-gray-400 rounded-lg text-sm">
                    {t('download.visualPackExtension')}
                  </button>
                </div>
                <div class="border border-white/10 rounded-lg p-4">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent to-chatgpt flex items-center justify-center">
                      <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                      </svg>
                    </div>
                    <div>
                      <p class="font-medium text-sm">AI Chat Exporter</p>
                      <p class="text-xs text-gray-500">v1.0.7</p>
                    </div>
                    <div class="ml-auto">
                      <div class="w-10 h-6 bg-accent rounded-full relative">
                        <div class="absolute right-0.5 top-0.5 w-5 h-5 bg-white rounded-full"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- FAQ Section -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-center mb-10">
            {t('download.faqTitle')}
          </h2>
          <div class="space-y-4">
            <div class="bg-bg-secondary rounded-xl p-6 border border-white/5">
              <h3 class="font-semibold mb-2">{t('download.faq1Q')}</h3>
              <p class="text-gray-400">{t('download.faq1A')}</p>
            </div>
            <div class="bg-bg-secondary rounded-xl p-6 border border-white/5">
              <h3 class="font-semibold mb-2">{t('download.faq2Q')}</h3>
              <p class="text-gray-400">{t('download.faq2A')}</p>
            </div>
            <div class="bg-bg-secondary rounded-xl p-6 border border-white/5">
              <h3 class="font-semibold mb-2">{t('download.faq3Q')}</h3>
              <p class="text-gray-400">{t('download.faq3A')}</p>
            </div>
            <div class="bg-bg-secondary rounded-xl p-6 border border-white/5">
              <h3 class="font-semibold mb-2">{t('download.faq4Q')}</h3>
              <p class="text-gray-400">{t('download.faq4A')}</p>
            </div>
          </div>
        </div>

        <!-- CTA -->
        <div class="text-center">
          <a
            href="/ai-chat-exporter.zip"
            download="ai-chat-exporter.zip"
            class="btn-primary text-lg px-10 py-4 inline-flex items-center gap-3"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            {t('download.button')}
          </a>
          <p class="text-sm text-gray-500 mt-4">
            {t('download.ctaNote')}
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
