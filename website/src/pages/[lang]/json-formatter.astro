---
import Layout from '../../layouts/Layout.astro';
import { type Lang, useTranslations, languages } from '../../i18n';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<Layout lang={lang} title={`${t('jsonFormatter.title')} - AI Chat Exporter`} description={t('jsonFormatter.description')}>
  <section class="py-12 md:py-20">
    <div class="container-custom">
      <!-- Header -->
      <div class="text-center mb-10">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
          {t('jsonFormatter.title')}
        </h1>
        <p class="text-gray-400 max-w-2xl mx-auto">
          {t('jsonFormatter.subtitle')}
        </p>
      </div>

      <!-- Tool Container -->
      <div class="max-w-6xl mx-auto">
        <!-- Input Area -->
        <div class="bg-bg-secondary rounded-2xl border border-white/10 overflow-hidden mb-6">
          <div class="flex items-center justify-between px-4 py-3 border-b border-white/10 bg-bg-tertiary">
            <span class="text-sm font-medium text-gray-300">{t('jsonFormatter.input')}</span>
            <div class="flex gap-2">
              <label class="text-xs px-3 py-1 rounded bg-white/5 text-gray-400 cursor-pointer hover:bg-white/10 transition-colors">
                {t('jsonFormatter.upload')}
                <input type="file" id="fileInput" accept=".json,.txt" class="hidden" />
              </label>
              <button
                id="pasteBtn"
                class="text-xs px-3 py-1 rounded bg-white/5 text-gray-400 hover:bg-white/10 transition-colors"
              >
                {t('jsonFormatter.paste')}
              </button>
              <button
                id="clearBtn"
                class="text-xs px-3 py-1 rounded bg-white/5 text-gray-400 hover:bg-white/10 transition-colors"
              >
                {t('jsonFormatter.clear')}
              </button>
            </div>
          </div>
          <textarea
            id="jsonInput"
            class="w-full h-[350px] p-4 bg-transparent text-gray-200 resize-none focus:outline-none font-mono text-sm leading-relaxed"
            placeholder={t('jsonFormatter.placeholder')}
            spellcheck="false"
          ></textarea>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap justify-center gap-3 mb-6">
          <button
            id="formatBtn"
            class="px-8 py-3 bg-gradient-to-r from-accent to-chatgpt text-white font-semibold rounded-xl hover:opacity-90 transition-opacity flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            {t('jsonFormatter.format')}
          </button>
          <button
            id="minifyBtn"
            class="px-8 py-3 bg-white/5 text-gray-300 font-semibold rounded-xl hover:bg-white/10 transition-colors flex items-center gap-2 border border-white/10"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            {t('jsonFormatter.minify')}
          </button>
          <button
            id="validateBtn"
            class="px-8 py-3 bg-white/5 text-gray-300 font-semibold rounded-xl hover:bg-white/10 transition-colors flex items-center gap-2 border border-white/10"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {t('jsonFormatter.validate')}
          </button>
        </div>

        <!-- Validation Status -->
        <div id="validationStatus" class="hidden mb-6">
          <div id="statusValid" class="hidden bg-green-500/10 border border-green-500/30 rounded-xl px-4 py-3 flex items-center gap-3">
            <svg class="w-5 h-5 text-green-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-green-400 text-sm font-medium">{t('jsonFormatter.validJson')}</span>
          </div>
          <div id="statusInvalid" class="hidden bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-3 flex items-center gap-3">
            <svg class="w-5 h-5 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span id="errorMessage" class="text-red-400 text-sm font-medium"></span>
          </div>
        </div>

        <!-- Output Area -->
        <div id="outputSection" class="hidden">
          <div class="bg-bg-secondary rounded-2xl border border-white/10 overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-white/10 bg-bg-tertiary">
              <span class="text-sm font-medium text-gray-300">{t('jsonFormatter.output')}</span>
              <div class="flex gap-2">
                <button
                  id="copyBtn"
                  class="text-xs px-3 py-1 rounded bg-white/5 text-gray-400 hover:bg-white/10 transition-colors"
                >
                  {t('jsonFormatter.copy')}
                </button>
                <button
                  id="downloadBtn"
                  class="text-xs px-3 py-1 rounded bg-white/5 text-gray-400 hover:bg-white/10 transition-colors"
                >
                  {t('jsonFormatter.download')}
                </button>
              </div>
            </div>
            <pre id="jsonOutput" class="p-4 font-mono text-sm leading-relaxed overflow-auto max-h-[600px] bg-transparent"></pre>
          </div>
        </div>

        <!-- Tips -->
        <div class="mt-10 bg-white/5 rounded-xl p-6 border border-white/10">
          <h3 class="text-lg font-semibold text-white mb-4">{t('jsonFormatter.tips')}</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {t('jsonFormatter.tip1')}
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {t('jsonFormatter.tip2')}
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {t('jsonFormatter.tip3')}
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {t('jsonFormatter.tip4')}
            </li>
          </ul>
        </div>

        <!-- Back to home -->
        <div class="mt-8 text-center">
          <a href={`/${lang}`} class="text-accent hover:text-accent/80 transition-colors text-sm">
            &larr; {t('jsonFormatter.backHome')}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const jsonInput = document.getElementById('jsonInput') as HTMLTextAreaElement;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;
  const pasteBtn = document.getElementById('pasteBtn');
  const clearBtn = document.getElementById('clearBtn');
  const formatBtn = document.getElementById('formatBtn');
  const minifyBtn = document.getElementById('minifyBtn');
  const validateBtn = document.getElementById('validateBtn');
  const copyBtn = document.getElementById('copyBtn');
  const downloadBtn = document.getElementById('downloadBtn');
  const validationStatus = document.getElementById('validationStatus');
  const statusValid = document.getElementById('statusValid');
  const statusInvalid = document.getElementById('statusInvalid');
  const errorMessage = document.getElementById('errorMessage');
  const outputSection = document.getElementById('outputSection');
  const jsonOutput = document.getElementById('jsonOutput');

  let currentOutputText = '';

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function syntaxHighlight(json: string): string {
    // Escape HTML first, then apply color spans
    const escaped = escapeHtml(json);
    return escaped.replace(
      /("(\\u[\da-fA-F]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?|\bnull\b)/g,
      (match: string) => {
        let color = '#e06c75'; // default: numbers (will be overridden)
        if (/^"/.test(match)) {
          if (/:$/.test(match)) {
            // Key
            color = '#61afef';
          } else {
            // String value
            color = '#98c379';
          }
        } else if (/true|false/.test(match)) {
          color = '#c678dd';
        } else if (/null/.test(match)) {
          color = '#e06c75';
        } else {
          // Number
          color = '#d19a66';
        }
        return `<span style="color:${color}">${match}</span>`;
      }
    );
  }

  function showValidationValid(): void {
    validationStatus?.classList.remove('hidden');
    statusValid?.classList.remove('hidden');
    statusInvalid?.classList.add('hidden');
  }

  function showValidationInvalid(msg: string): void {
    validationStatus?.classList.remove('hidden');
    statusInvalid?.classList.remove('hidden');
    statusValid?.classList.add('hidden');
    if (errorMessage) {
      errorMessage.textContent = msg;
    }
  }

  function hideValidation(): void {
    validationStatus?.classList.add('hidden');
    statusValid?.classList.add('hidden');
    statusInvalid?.classList.add('hidden');
  }

  function showOutput(text: string, highlight: boolean = true): void {
    currentOutputText = text;
    outputSection?.classList.remove('hidden');
    if (jsonOutput) {
      if (highlight) {
        jsonOutput.innerHTML = syntaxHighlight(text);
      } else {
        jsonOutput.textContent = text;
      }
    }
  }

  // Format
  formatBtn?.addEventListener('click', () => {
    const input = jsonInput.value.trim();
    if (!input) return;
    try {
      const parsed = JSON.parse(input);
      const formatted = JSON.stringify(parsed, null, 2);
      showOutput(formatted, true);
      showValidationValid();
    } catch (e: any) {
      showOutput('');
      const posMatch = e.message.match(/position\s+(\d+)/i);
      const pos = posMatch ? posMatch[1] : 'unknown';
      showValidationInvalid(`${e.message} (${pos})`);
    }
  });

  // Minify
  minifyBtn?.addEventListener('click', () => {
    const input = jsonInput.value.trim();
    if (!input) return;
    try {
      const parsed = JSON.parse(input);
      const minified = JSON.stringify(parsed);
      showOutput(minified, true);
      showValidationValid();
    } catch (e: any) {
      showOutput('');
      const posMatch = e.message.match(/position\s+(\d+)/i);
      const pos = posMatch ? posMatch[1] : 'unknown';
      showValidationInvalid(`${e.message} (${pos})`);
    }
  });

  // Validate
  validateBtn?.addEventListener('click', () => {
    const input = jsonInput.value.trim();
    if (!input) return;
    try {
      JSON.parse(input);
      showValidationValid();
    } catch (e: any) {
      const posMatch = e.message.match(/position\s+(\d+)/i);
      const pos = posMatch ? posMatch[1] : 'unknown';
      showValidationInvalid(`${e.message} (${pos})`);
    }
  });

  // Upload
  fileInput?.addEventListener('change', (e: Event) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      jsonInput.value = event.target?.result as string;
    };
    reader.readAsText(file);
  });

  // Paste
  pasteBtn?.addEventListener('click', async () => {
    try {
      const text = await navigator.clipboard.readText();
      jsonInput.value = text;
    } catch {
      // Clipboard access denied - ignore
    }
  });

  // Clear
  clearBtn?.addEventListener('click', () => {
    jsonInput.value = '';
    hideValidation();
    outputSection?.classList.add('hidden');
    currentOutputText = '';
  });

  // Copy
  copyBtn?.addEventListener('click', async () => {
    if (!currentOutputText) return;
    try {
      await navigator.clipboard.writeText(currentOutputText);
      if (copyBtn) {
        const original = copyBtn.textContent;
        copyBtn.textContent = '\u2713';
        setTimeout(() => {
          copyBtn.textContent = original;
        }, 1500);
      }
    } catch {
      // Clipboard access denied
    }
  });

  // Download
  downloadBtn?.addEventListener('click', () => {
    if (!currentOutputText) return;
    const blob = new Blob([currentOutputText], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'formatted.json';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
